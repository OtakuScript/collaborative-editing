# 运行模式
NODE_ENV=development

# api-service 使用的 PostgreSQL 数据库连接地址
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/collab_editing

# 用于签发和校验 JWT access token 的密钥
JWT_SECRET=change-me

# Markdown 文件存储根目录
STORAGE_ROOT=./data/storage

# 本机暴露端口，可按需修改；改动后同步调整对应 URL
WEB_PORT=5173
API_PORT=3000
COLLAB_PORT=1234
POSTGRES_PORT=5432

# collab-service 调用 api-service 内部接口时使用的服务端地址
API_INTERNAL_BASE_URL=http://localhost:3000

# 前端连接 collab-service 时使用的 WebSocket 地址
COLLAB_WS_URL=ws://localhost:1234

# Vite 前端请求 api-service 时使用的 API 地址
VITE_API_BASE_URL=http://localhost:3000

# Vite 前端连接协同服务时使用的 WebSocket 地址
VITE_COLLAB_WS_URL=ws://localhost:1234
